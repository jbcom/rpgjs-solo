{
  "name": "@rpgjs/chat",
  "version": "5.0.0-beta.2",
  "description": "Official renderer-neutral chat module for RPGJS",
  "main": "dist/client/index.js",
  "types": "dist/client/client-index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/client/client-index.d.ts",
        "import": "./dist/client/index.js"
      },
      "node": {
        "types": "./dist/server/server-index.d.ts",
        "import": "./dist/server/index.js"
      },
      "types": "./dist/client/client-index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client": {
      "types": "./dist/client/client-index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/server-index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --skipLibCheck true --target ES2022 --module ESNext --moduleResolution Bundler tests/public-api-types.ts && tsc --noEmit --strict --skipLibCheck true --target ES2022 --module NodeNext --moduleResolution NodeNext tests/public-api-node-types.ts && tsc --noEmit --strict --skipLibCheck true --target ES2022 --module ESNext --moduleResolution Bundler --customConditions browser tests/public-api-browser-types.ts"
  },
  "peerDependencies": {
    "@rpgjs/client": "workspace:*",
    "@rpgjs/common": "workspace:*",
    "@rpgjs/server": "workspace:*",
    "@rpgjs/vite": "workspace:*",
    "canvasengine": "^2.2.0"
  },
  "devDependencies": {
    "@canvasengine/compiler": "2.2.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module"
}
