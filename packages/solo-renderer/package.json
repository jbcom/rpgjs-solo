{
  "name": "@jbcom/rpgjs-solo-renderer",
  "version": "5.0.0-beta.29.solo.1",
  "description": "Native CanvasEngine renderer and Tiled authoring surface for RPGJS Solo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/rpgjs-solo.git",
    "directory": "packages/solo-renderer"
  },
  "homepage": "https://github.com/jbcom/rpgjs-solo/tree/main/packages/solo-renderer#readme",
  "bugs": {
    "url": "https://github.com/jbcom/rpgjs-solo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "node ../../bin/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "verify:package": "node ../../bin/verify-solo-package-contracts.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://git.local.jonbogaty.com/api/packages/jbcom/npm/"
  },
  "dependencies": {
    "@canvasengine/presets": "2.1.0",
    "@canvasengine/tiled": "2.1.0",
    "@jbcom/rpgjs-solo": "workspace:5.0.0-beta.29.solo.1",
    "canvasengine": "2.1.1"
  },
  "peerDependencies": {
    "pixi.js": "8.19.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "pixi.js": "8.19.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
