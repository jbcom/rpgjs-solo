{
  "name": "rpgjs-solo",
  "version": "5.0.0-beta.29.solo.2",
  "description": "Transport-free, deterministic single-player RPG runtime built from RPGJS v5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/rpgjs-solo.git",
    "directory": "packages/solo"
  },
  "homepage": "https://github.com/jbcom/rpgjs-solo/tree/main/packages/solo#readme",
  "bugs": {
    "url": "https://github.com/jbcom/rpgjs-solo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "node ../../bin/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:boundary": "node scripts/verify-boundary.mjs"
  },
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "devDependencies": {
    "@rpgjs/physic": "workspace:5.0.2",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.3"
  },
  "author": "Jon Bogaty <jon@jonbogaty.com>"
}
